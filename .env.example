# 高值耗材扫码计费闭环系统 · 环境变量样例
# 复制为 .env 后填入院内真实值。全部凭据只从环境变量读取，不落配置文件、不硬编码。
# 缺任一路凭据 → 该路拒绝启动并在日志中指名变量名。

# ── 入站路：扫码枪 / RFID 网关投递扫码事件 ────────────────────────────
# 扫码事件服务基址（入站事件由设备侧投递，本进程作为服务接收）
OR_SCANNER_BASE_URL=
# 设备侧调用本进程入站接口时携带的 Bearer 令牌
OR_SCANNER_TOKEN=
# 入站请求体 HMAC-SHA256 签名密钥（"{timestamp}.{nonce}.{raw_body}"）
OR_SCANNER_SECRET=
# 入站重放防护第一层：时间戳容差窗口（秒，留空取默认 300）。
# 设备时钟与本侧时钟相差超过这个秒数就按「过期」拒（401 ERR_STALE_TIMESTAMP）
SCANNER_TIMESTAMP_TOLERANCE_SEC=
# 入站重放防护第二层：nonce 有效期（秒，留空取默认 600）。
# 同一个 nonce 在这个时长内第二次投递 = 按重放拒（401 ERR_REPLAY_NONCE_REPLAY）。
# 设备侧每次投递（含重试）都要换一个新 nonce
SCANNER_NONCE_TTL_SEC=
# nonce 过期记录的清理周期（毫秒，留空取默认 60000）：多久扫一次过期记录
SCANNER_NONCE_CLEANUP_INTERVAL_MS=
# 扫码枪位置登记簿（可选；不配 = 只核「事件手术间 vs 排台手术间」一个因子）。
# 格式：扫码枪编号=手术间[,科室]，多条用分号分隔。例如：
#   OR_SCANNER_REGISTRY=SCAN-GUN-07=OR-01,SURG-01;SCAN-GUN-08=OR-02
# 登记了科室才会参与「科室」这第二个因子的核对；登记与事件不一致时按归属冲突处理并留审计。
OR_SCANNER_REGISTRY=

# ── 出站路：回写 HIS 耗材计费明细 ──────────────────────────────────────
# HIS 计费服务基址
HIS_CHARGING_BASE_URL=
# 出站调用使用的 Bearer 令牌（仅在出站客户端盖章，业务层与日志拿不到明文）
HIS_CHARGING_TOKEN=
# 出站计费端点路径（留空取默认 /api/v1/material-uses）
HIS_CHARGING_MATERIAL_USES_PATH=
# 出站请求超时（毫秒，留空取默认 10000）：
# 这是**响应**超时的基数 —— 实际等待时间按本批条目数线性放大（有上限封顶）
HIS_CHARGING_TIMEOUT_MS=
# 出站**连接**超时（毫秒，留空取默认 5000）：TCP 建连 + TLS 握手的预算。
# 与响应超时分开：连不上（看地址端口与网络策略）与连上了不回应（看对端负载）是两回事
HIS_CHARGING_CONNECT_TIMEOUT_MS=
# 响应超时按条目数放大后的上限（毫秒，留空取默认 60000）：再大的批次也不无限等
HIS_CHARGING_MAX_RESPONSE_TIMEOUT_MS=
# 出站连接池保活时长（毫秒，留空取默认 30000）：keep-alive 连接多久不用就回收
HIS_CHARGING_KEEP_ALIVE_MS=
# 出站连接池最大并发连接数（留空取默认 16）
HIS_CHARGING_MAX_SOCKETS=
# 熔断阈值（连续几次通道级失败后短路，留空取默认 5）：
# 连续失败达阈值后，出站请求直接短路不再外发，条目照常进退避重投队列（不丢数据）
HIS_CHARGING_CIRCUIT_FAILURE_THRESHOLD=
# 熔断冷却时长（毫秒，留空取默认 30000）：短路后多久放一次探测，探测成功即恢复
HIS_CHARGING_CIRCUIT_COOLDOWN_MS=
# 单次计费请求的条目数上限（对端限批，留空取默认 100）：
# 超过就按批切分，逐批独立结算 —— 某批整体失败只让该批进退避重投，其余批照常落库
HIS_CHARGING_MAX_BATCH_SIZE=

# ── 推送路：企业微信机器人（推送既有通道，不新造消息中心）─────────────
WECOM_WEBHOOK_URL=
WECOM_SECRET=
# 企微批次摘要的**聚合窗口**（毫秒，默认 30000）：
# 同一台次的异常在这个窗口内合并成一条消息，窗口结束才发出 ——
# 一台手术扫十几次耗材，群里只说一条，不刷屏。
# 同一耗材码 + 同一结论在一个窗口内只出现一次（重复扫码不重复推）。
NOTIFY_AGGREGATION_WINDOW_MS=

# ── 运行参数（非凭据位，留空取默认值）─────────────────────────────────
# 台账 SQLite 文件路径（默认 data/ledger.db）
LEDGER_DB_PATH=
# RFID 网关目录投递箱（默认 scan-inbox）
SCAN_INBOX_DIR=
# 入站 HTTP 监听端口（默认 8099）
HTTP_PORT=
# 台账忙等超时（毫秒，默认 5000）：并发写撞上时等一会儿再报错
LEDGER_BUSY_TIMEOUT_MS=
# 单事务批量提交的条目上限（默认 200）：超过就按批切分，每批一个事务
LEDGER_BATCH_SIZE=
# 幂等键档位：v1（默认，耗材码 + 台次，同码同台次只算一次）/ v2（耗材码 + 台次 + 批号，
# 同码同台次的不同批号各算一次）。取值非法 → 启动即报错并指名本变量名。
# 该档位随出站请求一并发给 HIS 计费侧（字段 key_profile），供对端按版本灰度去重；
# 已绑上台账的老行按行上的档位透传，不会被本配置改写。
IDEMPOTENCY_KEY_PROFILE=

# ── 主数据热更新（导入即生效 · 不重启常驻进程）────────────────────────
# 配了下面两个路径，守护进程会盯着文件：文件一变就自动重导一次，
# 判定立刻按新值走（耗材新建档 / 停用、临时加台、提前关台都不用重启进程）。
# 两个都留空 = 不启用自动热更新（改完主数据需手工跑一次 import-master 命令）。
MASTER_DATA_OPERATIONS_CSV=
MASTER_DATA_MATERIALS_CSV=
# 热更新检查间隔（毫秒，默认 30000）
MASTER_DATA_RELOAD_INTERVAL_MS=
# 主数据 CSV 的编码策略：
#   auto（默认）= UTF-8 与 GBK 里择优（老系统导 GBK、新系统导 UTF-8 都能读；
#                两个都能解时按「中文多、解错字符少」择优，避免把 GBK 当 UTF-8 解成乱码）
#   utf-8 / gbk = 只认这一种（导出方固定编码时可以锁死，避免误判）
# 解不出来时**保留原始字节并报错**，绝不用替换字符把乱码拼成「看起来像文本」。
MASTER_DATA_ENCODING=

# ── 事件日志保留策略（清的是日志，不是账）───────────────────────────────
# 事件日志是排查问题的一手材料（原始报文逐字保留），但常驻进程每天都在收 ——
# 不设上限的话表会无限长，把同块磁盘上的业务数据挤掉。
# 清理口径：先按保留期清过期行，剩下的还超上限再按最旧清；清了就在审计链留一行。
# 台账行、计费回执、核查任务、审计链一律不动。
# 保留期（天，留空取默认 30）
EVENT_LOG_RETENTION_DAYS=
# 最大行数（行，留空取默认 100000）
EVENT_LOG_MAX_ROWS=
# 清理周期（毫秒，留空取默认 3600000，即 1 小时）
EVENT_LOG_CLEANUP_INTERVAL_MS=
